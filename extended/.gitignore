# Leading "/" anchors a rule to the project root. Without it, "model/" also
# matches the Java package src/main/java/.../model/.

# Build output
/target/

# Trained model files (created on first start, see README)
/model/
*.dnet
fraud-model.bin

# IDEs
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
nbproject/private/

# Logs and temporary files
*.log
/logs/
*.tmp

# Local environment files (may hold secrets)
.env
.env.*

# OS files
.DS_Store
Thumbs.db
desktop.ini
